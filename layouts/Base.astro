---
// The HTML shell of every page: head, site styles, KaTeX's styles and the blog's symbol colors (src/roles.js). Pages
// pass a title and description.
import 'katex/dist/katex.min.css'
import '../styles/site.css'
import { site } from '@/site.js'
import { roleCss } from '../lib/roles.js'

const { title, description = site.description, bodyClass } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:inline set:html={roleCss} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
