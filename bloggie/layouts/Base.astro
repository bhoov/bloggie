---
// The HTML shell of every page: head, site styles and KaTeX's styles. Pages pass a title and description.
import 'katex/dist/katex.min.css'
import '../styles/site.css'
import { site } from '../../src/site.js'

const { title, description = site.description, bodyClass } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
